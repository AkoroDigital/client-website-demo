# Copy this file to .env.local for local testing (that file is gitignored
# and never committed). For the live site, set this same variable in
# Vercel's dashboard instead: Project -> Settings -> Environment Variables.
#
# Never put a real key directly in this file — .env.example is committed
# to the repo and meant to show what's needed, not hold real secrets.

ANTHROPIC_API_KEY=

# --- Lead SMS notifications (api/notify-lead.js) ---
# Twilio Console -> Account SID and Auth Token are on the dashboard home.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number you send FROM, in +1XXXXXXXXXX format.
TWILIO_FROM_NUMBER=
# The business owner's real cell number, in +1XXXXXXXXXX format.
OWNER_PHONE_NUMBER=
# A shared secret so only Supabase's webhook can trigger this function.
# A value has already been generated for you — see the chat message.
SUPABASE_WEBHOOK_SECRET=
