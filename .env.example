# Copy this file to .env.local for local testing (that file is gitignored
# and never committed). For the live site, set this same variable in
# Vercel's dashboard instead: Project -> Settings -> Environment Variables.
#
# Never put a real key directly in this file — .env.example is committed
# to the repo and meant to show what's needed, not hold real secrets.

ANTHROPIC_API_KEY=
