# Copy this file to .env.local for local testing (that file is gitignored
# and never committed). For the live site, set this same variable in
# Vercel's dashboard instead: Project -> Settings -> Environment Variables.
#
# Never put a real key directly in this file — .env.example is committed
# to the repo and meant to show what's needed, not hold real secrets.

# Used by the after-hours missed-call assistant to decide when to book,
# once texting (api/sms-incoming.js) is switched back on after A2P
# clears. Not currently on the active call path, but keep it set.
ANTHROPIC_API_KEY=

# --- Lead email notifications (api/notify-lead.js) ---
# Using email instead of SMS for now — no carrier registration needed,
# works immediately, while A2P 10DLC verification is still pending.
# Resend (resend.com) API key.
RESEND_API_KEY=
# Optional: a verified sending address on your own domain, once you've
# set one up in Resend. Leave blank to use Resend's shared test sender
# (onboarding@resend.dev), which works without any domain setup.
RESEND_FROM_EMAIL=
# The business owner's real email — where lead notifications go.
OWNER_EMAIL=
# A shared secret so only Supabase's webhook can trigger this function.
# A value has already been generated for you — see the chat message.
SUPABASE_WEBHOOK_SECRET=

# --- Missed-call voice capture (api/voice-*.js) ---
# Twilio Console -> Auth Token is on the dashboard home. Used to verify
# incoming webhooks are genuinely from Twilio, not SMS sending.
TWILIO_AUTH_TOKEN=
# The business owner's real cell number, in +1XXXXXXXXXX format —
# this is who Twilio tries to ring first on every incoming call.
OWNER_PHONE_NUMBER=
# Not required for the current voice-only flow, but keep these set —
# needed again once A2P clears and texting is switched back on.
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=

# Same value as app/assets/supabase-client.js's SUPABASE_URL — Project
# Settings -> API -> Project URL.
SUPABASE_URL=
# DANGER: this key bypasses every security rule in supabase/schema.sql.
# Project Settings -> API -> "service_role" (labeled secret). Never put
# this in any file the browser loads — server-side (/api, /lib) only.
SUPABASE_SERVICE_ROLE_KEY=
